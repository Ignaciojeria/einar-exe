# ============================================================
# einar-exe — Variables de entorno (PLANTILLA)
# ============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# NO commitear `.env` (ya está en .gitignore).
# ============================================================

# ------------------------------------------------------------
# App (Go)
# ------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# Conexión a su propia database (usuario sin privilegios sobre `casdoor`)
DATABASE_URL=postgres://einar:CHANGE_ME@db:5432/einar?sslmode=disable

# ------------------------------------------------------------
# Postgres (servicio `db`)
# ------------------------------------------------------------
# Superusuario — solo se usa en el primer arranque y para mantenimiento
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_ROOT
POSTGRES_DB=einar

# Usuarios por database (los crea db/init/01-init.sql)
EINAR_DB_USER=einar
EINAR_DB_PASSWORD=CHANGE_ME_EINAR
EINAR_DB_NAME=einar

CASDOOR_DB_USER=casdoor
CASDOOR_DB_PASSWORD=CHANGE_ME_CASDOOR
CASDOOR_DB_NAME=casdoor

# ------------------------------------------------------------
# Casdoor (servicio `casdoor`)
# ------------------------------------------------------------
CASDOOR_PORT=8000

# URL pública (la que ve el navegador del usuario en el flujo OAuth)
CASDOOR_ORIGIN=http://localhost:8000
CASDOOR_ORIGIN_FRONTEND=http://localhost:8000

# URL interna (server-to-server, dentro de la red de Docker)
CASDOOR_ENDPOINT_INTERNAL=http://casdoor:8000

# Cadena de conexión que Casdoor usa contra Postgres
# (debe coincidir con CASDOOR_DB_USER / CASDOOR_DB_PASSWORD / CASDOOR_DB_NAME)
CASDOOR_DRIVER=postgres
CASDOOR_DATA_SOURCE="user=casdoor password=CHANGE_ME_CASDOOR host=db port=5432 sslmode=disable dbname="

# Credenciales del admin que se crea al bootstrappear (init_data.json)
CASDOOR_ADMIN_USERNAME=admin
CASDOOR_ADMIN_PASSWORD=CHANGE_ME_ADMIN

# ------------------------------------------------------------
# Integración OAuth2/OIDC: app ↔ Casdoor
# ------------------------------------------------------------
# Estos valores se obtienen de Casdoor tras crear la Application
# (UI: Applications → einar-app). Si usas init_data.json puedes fijarlos
# desde el inicio.
CASDOOR_ORG_NAME=einar
CASDOOR_APP_NAME=einar-app
CASDOOR_CLIENT_ID=CHANGE_ME_CLIENT_ID
CASDOOR_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET

# Clave pública (PEM) del certificado de Casdoor para verificar JWT.
# Se obtiene en: Casdoor UI → Certs → <cert de la app> → Public key.
# Pegar en una sola línea con \n o cargar desde archivo montado.
CASDOOR_JWT_PUBLIC_KEY=

# Redirect URI que la app expone para recibir el `code` de OAuth
APP_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# Estrategia de sesión MVP: JWT puro de Casdoor en cookie HttpOnly.
# La app NO firma sesiones propias, por eso no hay APP_SESSION_SECRET.
# Ver docs/casdoor-integration-plan.md §12.
