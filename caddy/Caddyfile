# Caddy = único ingress público del stack.
#
# exe.dev hace TLS termination en https://einar.exe.xyz/ y forwardea a este
# Caddy en HTTP plano dentro de la VM. Caddy reparte por path a los
# servicios internos.
#
# Auth: exe.dev proxy inyecta X-ExeDev-UserID y X-ExeDev-Email headers
# antes de llegar aquí. La app Go los lee directamente.

:80 {
    log {
        output stdout
        format console
    }

    # ── METABASE bajo /mb/* ────────────────────────────────────────────
    handle_path /mb/* {
        reverse_proxy metabase:3000
        header -X-Frame-Options
        header -Content-Security-Policy
    }
    handle /mb {
        redir /mb/ permanent
    }

    # ── OPENOBSERVE bajo /o2/* ──────────────────────────────────────────
    handle /o2/* {
        reverse_proxy openobserve:5080
    }
    handle /o2 {
        redir /o2/ permanent
    }

    # ── PGWEB bajo /pgweb/* ─────────────────────────────────────────────
    handle_path /pgweb/* {
        basic_auth {
            {$PGWEB_USER:admin} {$PGWEB_HASH}
        }
        reverse_proxy pgweb:8081
    }
    handle /pgweb {
        redir /pgweb/ permanent
    }

    # ── APP Go: default handler ────────────────────────────────────────
    # All remaining traffic goes to the Go app.
    # Auth is handled by exe.dev proxy headers (X-ExeDev-UserID,
    # X-ExeDev-Email) injected before reaching Caddy.
    handle {
        reverse_proxy app:8080
    }
}
