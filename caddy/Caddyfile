# Caddy = único ingress público del stack.
#
# exe.dev hace TLS termination en https://einar.exe.xyz/ y forwardea a este
# Caddy en HTTP plano dentro de la VM. Caddy reparte por path a los 4
# servicios internos.
#
# Modelo de ruteo:
#   - APP captura un set acotado de rutas conocidas (allowlist).
#   - CASDOOR captura todo lo demás por defecto (UI, OAuth, /.well-known, ...).
#   - REDASH y OPENOBSERVE bajo subpath con strip-prefix.
#
# Cuando agregues un endpoint nuevo a la app, agrégalo aquí también.

:80 {
    log {
        output stdout
        format console
    }

    # ── REDASH bajo /redash/* ─────────────────────────────────────────
    # Strip-prefix: REDASH_BASE_URL en sus env vars debe apuntar a
    # /redash para que sus links absolutos sean correctos.
    handle_path /redash/* {
        reverse_proxy redash-server:5000
    }

    # ── OPENOBSERVE bajo /o2/* ────────────────────────────────────────
    # OO corre con ZO_BASE_URI=/o2 → sirve assets bajo /o2/* internamente.
    # Por eso `handle` y NO `handle_path`: no strippeamos el prefijo.
    handle /o2/* {
        reverse_proxy openobserve:5080
    }
    # /o2 sin slash → redirect al / (estilo nginx).
    handle /o2 {
        redir /o2/ permanent
    }

    # ── APP Go: rutas conocidas ───────────────────────────────────────
    @app {
        # Shell SPA (React)
        path /                 # landing
        path /assets/*         # bundle Vite (JS/CSS/svg con hash)
        path /vite.svg
        path /favicon.svg
        path /icons.svg
        # Auth flow (handlers Go)
        path /auth/*           # /auth/login, /auth/callback, /auth/logout, /auth/refresh
        # API de la app
        path /api/me
        path /api/session
        path /api/signup       # crea tenant + asigna user (Fase 1)
        path /api/embedded-apps*
        path /api/embedded-token
        path /api/credentials
        path /api/tenants*
        # SPA pages servidas por el handler de Go (devuelve index.html)
        path /signup
        path /signup/*
        path /t/*              # /t/{tenant-slug}/...
        # Otros
        path /hello            # smoke test
        path /sdk/*            # SDK servido para embedded apps (Fase 4)
    }
    handle @app {
        reverse_proxy app:8080
    }

    # ── Default: CASDOOR ──────────────────────────────────────────────
    # Cubre: UI (/, /home, /apps, /users, /providers, ...), OAuth endpoints
    # (/login/oauth/*, /callback, /api/login/oauth/*), discovery
    # (/.well-known/*), admin API (/api/get-*, /api/add-*, ...), recursos
    # estáticos (/static/*, /resource/*, /storage/*), etc.
    handle {
        reverse_proxy casdoor:8000
    }
}
