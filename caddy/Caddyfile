# Caddy = único ingress público del stack.
#
# exe.dev hace TLS termination en https://einar.exe.xyz/ y forwardea a este
# Caddy en HTTP plano dentro de la VM. Caddy reparte por path a los 4
# servicios internos.
#
# Modelo de ruteo:
#   - APP captura un set acotado de rutas conocidas (allowlist).
#   - CASDOOR captura todo lo demás por defecto (UI, OAuth, /.well-known, ...).
#   - METABASE y OPENOBSERVE bajo subpath.
#
# Cuando agregues un endpoint nuevo a la app, agrégalo aquí también.

:80 {
    log {
        output stdout
        format console
    }

    # ── METABASE bajo /mb/* ──────────────────────────────────────────
    # Metabase no soporta nativamente path prefix, pero para nuestro caso
    # de embedding (iframe) basta con strippear el prefijo en la request
    # y dejar que Metabase responda bajo "/" desde su perspectiva.
    # MB_SITE_URL le dice cuál es la URL pública (la usa para emails y
    # signed JWT URLs en el embedding flow).
    handle_path /mb/* {
        reverse_proxy metabase:3000
        # Metabase setea X-Frame-Options: DENY y CSP frame-ancestors 'none'
        # por default. Como el iframe vive en el mismo eTLD que el shell,
        # los strippeamos para permitir embed. Equivalente legal:
        # mismo dominio = misma identidad de seguridad.
        header -X-Frame-Options
        header -Content-Security-Policy
    }
    handle /mb {
        redir /mb/ permanent
    }

    # ── OPENOBSERVE bajo /o2/* ────────────────────────────────────────
    # OO corre con ZO_BASE_URI=/o2 → sirve assets bajo /o2/* internamente.
    # Por eso `handle` y NO `handle_path`: no strippeamos el prefijo.
    handle /o2/* {
        reverse_proxy openobserve:5080
    }
    # /o2 sin slash → redirect al / (estilo nginx).
    handle /o2 {
        redir /o2/ permanent
    }

    # ── APP Go: rutas conocidas ───────────────────────────────────────
    @app {
        # Shell SPA (React)
        path /                 # landing
        path /assets/*         # bundle Vite (JS/CSS/svg con hash)
        path /vite.svg
        path /favicon.svg
        path /icons.svg
        # Auth flow (handlers Go)
        path /auth/*           # /auth/login, /auth/callback, /auth/logout, /auth/refresh
        # API de la app
        path /api/me
        path /api/session
        path /api/signup       # crea tenant + asigna user (Fase 1)
        path /api/embedded-apps*
        path /api/embedded-token
        path /api/credentials
        path /api/tenants*
        # Endpoints públicos para validación third-party (sin cookie):
        path /whoami           # introspect de un einar JWT
        path /.well-known/einar/*  # JWKS y discovery del signer einar
        # SPA pages servidas por el handler de Go (devuelve index.html)
        path /signup
        path /signup/*
        path /t/*              # /t/{tenant-slug}/...
        # Otros
        path /hello            # smoke test
        path /sdk/*            # SDK servido para embedded apps (Fase 4)
    }
    handle @app {
        reverse_proxy app:8080
    }

    # ── Default: CASDOOR ──────────────────────────────────────────────
    # Cubre: UI (/, /home, /apps, /users, /providers, ...), OAuth endpoints
    # (/login/oauth/*, /callback, /api/login/oauth/*), discovery
    # (/.well-known/*), admin API (/api/get-*, /api/add-*, ...), recursos
    # estáticos (/static/*, /resource/*, /storage/*), etc.
    handle {
        reverse_proxy casdoor:8000
    }
}
